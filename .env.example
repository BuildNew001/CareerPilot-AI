# OpenAI API key for LLM resume extraction & AI Career Copilot tool calling
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: override default OpenAI chat model (default: gpt-4o-mini)
CAREERPILOT_OPENAI_MODEL=gpt-4o-mini

# Optional: override Sentence Transformers embedding model (default: all-MiniLM-L6-v2)
CAREERPILOT_EMBEDDING_MODEL=all-MiniLM-L6-v2
